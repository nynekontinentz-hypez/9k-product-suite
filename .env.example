# Copy to .env and fill in values
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=./data/portal.db

# For production (Render), set DATABASE_URL to your PostgreSQL connection string.
# The app auto-detects postgres:// vs file path and switches drivers accordingly.

# Email (optional — stub mode used if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@9ksystems.net

# Portal URL (used in email links)
PORTAL_URL=http://localhost:3000

NODE_ENV=development
PORT=3000
