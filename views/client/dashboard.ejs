<%- include('../partials/page-start', { title: 'Dashboard', user, isAdmin: false, activePath: '/client', extraCss: '/public/css/ori.css' }) %>

<div class="topbar">
  <div class="topbar-title">Dashboard</div>
  <div class="topbar-actions">
    <a href="/client/tickets/new" class="btn btn-primary btn-sm">+ New Ticket</a>
  </div>
</div>
<div class="page">

  <% if (contract) { %>
  <div class="tier-card mb-4">
    <div class="tier-name"><%= client.tier_name || 'Plan' %></div>
    <div class="tier-price">$<%= client.tier_price || contract.monthly_rate %>/mo — Active contract</div>
    <% if (contract.features) { %>
    <ul class="tier-features">
      <% contract.features.split(',').forEach(function(f) { %>
        <li><%= f.trim() %></li>
      <% }) %>
    </ul>
    <% } %>
  </div>
  <% } %>

  <div class="stats-grid">
    <div class="stat-card <%= openCount > 0 ? 'accent' : '' %>">
      <div class="stat-label">Open Tickets</div>
      <div class="stat-value"><%= openCount %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Tickets</div>
      <div class="stat-value"><%= tickets.length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Plan</div>
      <div class="stat-value" style="font-size:1.1rem;padding-top:4px"><%= client.tier_name || '—' %></div>
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <div class="section-title">Recent Tickets</div>
      <a href="/client/tickets" class="text-sm text-accent">View all →</a>
    </div>
    <% if (tickets.length === 0) { %>
    <div class="card">
      <div class="empty-state">
        <div class="empty-icon">◎</div>
        <p>No tickets yet. <a href="/client/tickets/new">Submit your first request.</a></p>
      </div>
    </div>
    <% } else { %>
    <div class="card" style="padding:0">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Title</th><th>Category</th><th>Urgency</th><th>Status</th><th>Created</th>
            </tr>
          </thead>
          <tbody>
            <% tickets.forEach(function(t) { %>
            <tr>
              <td class="text-muted">#<%= t.id %></td>
              <td><a href="/client/tickets/<%= t.id %>" class="table-link"><%= t.title %></a></td>
              <td class="text-muted"><%= t.category %></td>
              <td><span class="badge badge-<%= t.urgency %>"><%= t.urgency %></span></td>
              <td><span class="badge badge-<%= t.status.replace('_','-') %>"><%= t.status.replace('_',' ') %></span></td>
              <td class="text-muted text-sm"><%= new Date(t.created_at).toLocaleDateString() %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ORI Score Card -->
  <div class="section">
    <% if (oriLatest) {
      const oriScore = parseFloat(oriLatest.overall_score);
      const oriLevel = oriGetLevel(oriScore);
    %>
    <div class="card" style="padding:20px 24px;border:1px solid rgba(34,211,238,0.15);background:linear-gradient(135deg,var(--surface),rgba(34,211,238,0.03))">
      <div class="flex items-center justify-between" style="flex-wrap:wrap;gap:12px">
        <div style="display:flex;align-items:center;gap:16px">
          <div style="text-align:center">
            <div style="font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:<%= oriLevel.color %>;line-height:1">
              <%= oriScore.toFixed(1) %>
            </div>
            <div style="font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em">/ 10</div>
          </div>
          <div>
            <div style="font-family:'Space Grotesk',sans-serif;font-weight:600;margin-bottom:2px">Operational Resilience Index</div>
            <div class="text-muted text-sm">
              <span style="color:<%= oriLevel.color %>;font-weight:600"><%= oriLevel.label %></span>
              — Last assessed <%= new Date(oriLatest.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %>
            </div>
          </div>
        </div>
        <div style="display:flex;gap:8px">
          <a href="/client/ori/results/<%= oriLatest.id %>" class="btn btn-secondary btn-sm">View Report</a>
          <a href="/client/ori" class="btn btn-primary btn-sm" style="background:rgba(34,211,238,0.15);color:#22d3ee;border:1px solid rgba(34,211,238,.3)">ORI Hub →</a>
        </div>
      </div>
    </div>
    <% } else { %>
    <div class="card" style="padding:20px 24px;border:1px solid rgba(34,211,238,0.1)">
      <div class="flex items-center justify-between" style="flex-wrap:wrap;gap:12px">
        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-weight:600;margin-bottom:4px">Operational Resilience Index</div>
          <div class="text-muted text-sm">Run your first assessment to see your security posture score.</div>
        </div>
        <a href="/client/ori/assessment" class="btn btn-primary btn-sm">Run Assessment →</a>
      </div>
    </div>
    <% } %>
  </div>

  <div class="section">
    <div class="card" style="padding:16px 24px">
      <div class="flex items-center justify-between">
        <div>
          <div class="font-medium">Need to update your environment details?</div>
          <div class="text-muted text-sm">Asset count, cloud services, emergency contact</div>
        </div>
        <a href="/client/onboarding" class="btn btn-secondary btn-sm">Update environment →</a>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/page-end') %>
