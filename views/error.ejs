<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error — 9K Systems</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<body>
<div class="auth-shell">
  <div class="auth-card" style="max-width:480px">
    <div class="auth-logo">9K <span>SYSTEMS</span></div>
    <div class="card" style="text-align:center">
      <div style="font-size:3rem;margin-bottom:16px"><%= status || 500 %></div>
      <h2 style="margin-bottom:8px">Something went wrong</h2>
      <p class="text-muted" style="margin-bottom:24px"><%= message %></p>
      <a href="/" class="btn btn-secondary">Go home</a>
    </div>
  </div>
</div>
</body>
</html>
