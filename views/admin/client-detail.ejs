<%- include('../partials/page-start', { title: client.company_name, user, isAdmin: true, activePath: '/admin/clients' }) %>

<div class="topbar">
  <div class="topbar-title"><%= client.company_name %></div>
  <div class="topbar-actions">
    <a href="/admin/clients" class="btn btn-secondary btn-sm">← Clients</a>
  </div>
</div>
<div class="page">
  <% if (created) { %>
  <div class="alert alert-success">Client created and invite email sent.</div>
  <% } %>

  <div class="content-grid">
    <div>
      <div class="section">
        <div class="section-header">
          <div class="section-title">Open Tickets</div>
          <a href="/admin/tickets?client=<%= client.id %>" class="text-sm text-accent">View all</a>
        </div>
        <% var openTickets = tickets.filter(function(t){ return t.status !== 'closed'; }); %>
        <% if (openTickets.length === 0) { %>
        <div class="card"><div class="empty-state"><div class="empty-icon">◎</div><p>No open tickets.</p></div></div>
        <% } else { %>
        <div class="card" style="padding:0">
          <div class="table-wrap">
            <table>
              <thead><tr><th>#</th><th>Title</th><th>Urgency</th><th>Status</th></tr></thead>
              <tbody>
                <% openTickets.forEach(function(t) { %>
                <tr>
                  <td class="text-muted">#<%= t.id %></td>
                  <td><a href="/admin/tickets/<%= t.id %>" class="table-link"><%= t.title %></a></td>
                  <td><span class="badge badge-<%= t.urgency %>"><%= t.urgency %></span></td>
                  <td><span class="badge badge-<%= t.status.replace('_','-') %>"><%= t.status.replace('_',' ') %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>
      </div>

      <div class="section">
        <div class="section-title mb-2">Contracts</div>
        <% if (contracts.length === 0) { %>
        <div class="card"><div class="empty-state"><p>No contracts.</p></div></div>
        <% } else { %>
        <div class="card" style="padding:0">
          <div class="table-wrap">
            <table>
              <thead><tr><th>Tier</th><th>Monthly Rate</th><th>Start</th><th>Status</th></tr></thead>
              <tbody>
                <% contracts.forEach(function(c) { %>
                <tr>
                  <td><%= c.tier_name || '—' %></td>
                  <td>$<%= c.monthly_rate %></td>
                  <td class="text-sm text-muted"><%= c.start_date %></td>
                  <td><span class="badge badge-<%= c.status === 'active' ? 'closed' : 'normal' %>"><%= c.status %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>
      </div>
    </div>

    <div>
      <!-- ORI Score Card -->
      <% if (oriLatest) {
        const oriScore = parseFloat(oriLatest.overall_score);
        const oriLvl = getScoreLevel(oriScore);
      %>
      <div class="card mb-3" style="border-color:rgba(34,211,238,.15)">
        <div class="card-title mb-2" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)">Operational Resilience Index</div>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px">
          <div style="font-family:var(--font-head);font-size:2rem;font-weight:700;color:<%= oriLvl.color %>;line-height:1"><%= oriScore.toFixed(1) %></div>
          <div>
            <div style="font-weight:600;color:<%= oriLvl.color %>"><%= oriLvl.label %></div>
            <div class="text-xs text-muted">Last assessed <%= new Date(oriLatest.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;font-size:.75rem;text-align:center">
          <% [['Identity',parseFloat(oriLatest.identity_score)],['Continuity',parseFloat(oriLatest.continuity_score)],['Resilience',parseFloat(oriLatest.resilience_score)]].forEach(function(p){ %>
          <div style="background:var(--surface2);border-radius:6px;padding:6px 4px">
            <div style="font-weight:700;color:<%= getScoreLevel(p[1]).color %>"><%= p[1].toFixed(1) %></div>
            <div style="color:var(--muted)"><%= p[0] %></div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } else { %>
      <div class="card mb-3" style="border-color:rgba(34,211,238,.1)">
        <div class="card-title mb-1" style="font-size:.75rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted)">Operational Resilience Index</div>
        <div class="text-sm text-muted">No assessment on record.</div>
      </div>
      <% } %>

      <div class="card mb-3">
        <div class="card-title mb-3">Client Info</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div class="detail-item"><label>Primary Contact</label><p><%= client.primary_contact_name %><% if (client.primary_contact_role) { %> · <%= client.primary_contact_role %><% } %></p></div>
          <div class="detail-item"><label>Email</label><p><%= client.primary_contact_email %></p></div>
          <% if (client.phone) { %>
          <div class="detail-item"><label>Phone</label><p><%= client.phone %></p></div>
          <% } %>
          <div class="detail-item"><label>Plan</label><p>
            <% if (client.tier_name) { %>
            <span class="badge badge-tier"><%= client.tier_name %></span>
            <% } else { %>
            —
            <% } %>
          </p></div>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-title mb-3">Digital Intake Profile</div>
        <% if (playbook) { %>
        <div class="alert alert-info py-2 mb-3" style="font-size: 0.8rem; border-color: var(--accent); background: rgba(255,122,0,0.1);">
          <strong>Matched Playbook:</strong> <a href="/admin/playbooks/<%= playbook.id %>" class="text-accent underline"><%= playbook.name %></a>
        </div>
        <% } %>
        <div style="display:flex;flex-direction:column;gap:12px">
          <div class="detail-item"><label>Industry</label><p><%= client.industry || '—' %></p></div>
          <div class="detail-item"><label>Location</label><p><%= client.city || '—' %></p></div>
          <% if (client.website) { %>
          <div class="detail-item"><label>Website</label><p><a href="https://<%= client.website.replace('https://','').replace('http://','') %>" target="_blank" class="text-accent"><%= client.website %></a></p></div>
          <% } %>
          <div class="detail-item"><label>Endpoints</label><p><%= client.endpoint_count || 0 %></p></div>
          <div class="detail-item"><label>Business Age</label><p><%= client.business_age || '—' %></p></div>
          
          <div class="detail-item">
            <label>Tech Stack</label>
            <div class="flex flex-wrap gap-1 mt-1">
              <% if (client.uses_microsoft_365) { %><span class="badge badge-normal">M365</span><% } %>
              <% if (client.uses_google_workspace) { %><span class="badge badge-normal">Google Workspace</span><% } %>
              <% if (client.uses_azure_ad) { %><span class="badge badge-normal">Azure AD</span><% } %>
              <% if (client.uses_cloud_backup) { %><span class="badge badge-normal">Backup</span><% } %>
              <% if (client.uses_antivirus) { %><span class="badge badge-normal">AV</span><% } %>
              <% if (client.uses_firewall) { %><span class="badge badge-normal">Firewall</span><% } %>
              <% if (client.uses_vpn) { %><span class="badge badge-normal">VPN</span><% } %>
              <% if (client.uses_onsite_server) { %><span class="badge badge-normal">Server</span><% } %>
              <% if (client.os_windows) { %><span class="badge badge-secondary">Windows</span><% } %>
              <% if (client.os_mac) { %><span class="badge badge-secondary">macOS</span><% } %>
            </div>
          </div>

          <div class="detail-item">
            <label>Interests</label>
            <div class="flex flex-wrap gap-1 mt-1">
              <% if (client.interest_managed_it) { %><span class="badge badge-tier">Managed IT</span><% } %>
              <% if (client.interest_cybersecurity) { %><span class="badge badge-tier">Security</span><% } %>
              <% if (client.interest_compliance) { %><span class="badge badge-tier">Compliance</span><% } %>
            </div>
          </div>

          <div class="detail-item"><label>Budget</label><p><%= client.budget_range ? client.budget_range.replace('_','–').replace('plus','+') : '—' %></p></div>
          <div class="detail-item"><label>Timeline</label><p><%= client.timeline || '—' %></p></div>
          
          <% if (client.pain_point) { %>
          <div class="detail-item"><label>Pain Point</label><p class="text-sm italic">"<%= client.pain_point %>"</p></div>
          <% } %>
        </div>
      </div>

      <% if (client.emergency_contact_name) { %>
      <div class="card mb-3">
        <div class="card-title mb-2">Emergency Contact</div>
        <p class="text-sm"><%= client.emergency_contact_name %><% if (client.emergency_contact_phone) { %> · <%= client.emergency_contact_phone %><% } %></p>
      </div>
      <% } %>

      <% if (client.internal_notes) { %>
      <div class="card" style="border-color:var(--accent)">
        <div class="font-medium text-sm mb-1">Internal Notes</div>
        <p class="text-sm text-muted" style="white-space:pre-wrap"><%= client.internal_notes %></p>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/page-end') %>
