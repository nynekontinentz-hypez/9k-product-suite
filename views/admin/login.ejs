<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — 9K Systems</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<body>
<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-logo">9K <span>SYSTEMS</span> <span style="font-size:.7rem;color:var(--muted);letter-spacing:.05em">ADMIN</span></div>
    <div class="card">
      <h1 class="auth-title">Admin Sign In</h1>
      <p class="auth-subtitle">Restricted to 9K Systems staff only.</p>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" required autofocus autocomplete="email">
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Sign in</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
